# Environment Configuration
# Copy this file to .env and customize values

# Database (defaults to local SQLite, switch to Postgres if using docker)
DATABASE_URL=sqlite:///./energy_forecast.db

# JWT Security (CHANGE IN PRODUCTION!)
JWT_SECRET_KEY=replace_with_at_least_32_random_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Seed Admin User Configuration
ADMIN_EMAIL=admin@energyforecast.com
ADMIN_PASSWORD=replace_with_a_long_random_admin_password

# CORS
FRONTEND_URL=http://localhost:3000

# Application
DEBUG=False
APP_NAME=EnergyForecast API
APP_VERSION=1.0.0
