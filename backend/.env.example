# Environment Configuration
# Copy this file to .env and customize values

# Database
DATABASE_URL=postgresql://pfe:pfe_password@localhost:5432/energy_forecast

# JWT Security (CHANGE IN PRODUCTION!)
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production-2024
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
FRONTEND_URL=http://localhost:3000

# ML Models Directory
MODELS_DIR=../models

# Application
DEBUG=True
APP_NAME=EnergyForecast API
APP_VERSION=1.0.0

# SMTP Settings (Leave empty for console mock logging fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@energyforecast.com
SMTP_TLS=True

