# Environment Configuration
# Copy this file to .env and customize values

# Database (defaults to local SQLite, switch to Postgres if using docker)
DATABASE_URL=sqlite:///./energy_forecast.db

# JWT Security (CHANGE IN PRODUCTION!)
JWT_SECRET_KEY=replace_with_at_least_32_random_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Seed Admin User Configuration
ADMIN_EMAIL=admin@energyforecast.com
ADMIN_PASSWORD=replace_with_a_long_random_admin_password

# CORS
FRONTEND_URL=http://localhost:3000

# Application
DEBUG=False
APP_NAME=EnergyForecast API
APP_VERSION=1.0.0

# REQUIRED when DEBUG=False. Use an ISO date such as 2026-07-23.
LEGAL_OWNER_NAME=
LEGAL_CONTACT_EMAIL=
SUPPORT_EMAIL=
LEGAL_EFFECTIVE_DATE=

# Product V1 capabilities (disabled until their independent readiness gates pass)
FORECAST_168H_ENABLED=False
EMAIL_DELIVERY_ENABLED=False
GOOGLE_AUTH_ENABLED=False

# Required only when the corresponding integration is enabled
PUBLIC_FRONTEND_URL=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=EnergyForecast
EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_TIMEOUT_SECONDS=20
EMAIL_WORKER_POLL_SECONDS=30
EMAIL_LEASE_SECONDS=120
EMAIL_RETRY_BASE_SECONDS=60
EMAIL_MAX_ATTEMPTS=5
REFRESH_COOKIE_DOMAIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Durable local avatar storage
AVATAR_STORAGE_DIR=static/avatars
AVATAR_MAX_BYTES=2097152
AVATAR_MAX_DIMENSION=2048
AVATAR_CLEANUP_POLL_SECONDS=60
AVATAR_CLEANUP_MAX_ATTEMPTS=8
AVATAR_CLEANUP_RETRY_SECONDS=60
