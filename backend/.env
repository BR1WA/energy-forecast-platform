# Local development - using SQLite for quick testing
# Switch to PostgreSQL when running with Docker Compose
DATABASE_URL=sqlite:///./energy_forecast.db
JWT_SECRET_KEY=dev-secret-key-for-local-testing-only
FRONTEND_URL=http://localhost:3000
MODELS_DIR=../models
DEBUG=True

# SMTP Settings (leave empty for mock console logger fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@energyforecast.com
SMTP_TLS=True
