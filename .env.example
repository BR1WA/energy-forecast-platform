# Docker Compose Environment Configuration
# Copy this file to .env at the root directory

# Postgres Database Settings
POSTGRES_DB=energy_forecast
POSTGRES_USER=pfe
POSTGRES_PASSWORD=replace_with_a_long_random_database_password

# Application
# Set DEBUG=false in any non-local/deployed environment. When DEBUG is false the
# backend refuses to start if the secrets below still hold insecure placeholders.
DEBUG=false
FRONTEND_URL=http://localhost:3000

# JWT Security
# REQUIRED. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace_with_at_least_32_random_characters

# Admin Seeding Credentials
# ADMIN_PASSWORD is REQUIRED. Do not ship the default; rotate after first login.
ADMIN_EMAIL=admin@energyforecast.com
ADMIN_PASSWORD=replace_with_a_long_random_admin_password

# Browser-facing API URL embedded into the frontend build
NEXT_PUBLIC_API_URL=http://localhost:8000
