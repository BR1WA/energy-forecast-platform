# Docker Compose Environment Configuration
# Copy this file to .env at the root directory

# Postgres Database Settings
POSTGRES_DB=energy_forecast
POSTGRES_USER=pfe
POSTGRES_PASSWORD=replace_with_a_long_random_database_password

# Application
# Set DEBUG=false in any non-local/deployed environment. When DEBUG is false the
# backend refuses to start if the secrets below still hold insecure placeholders.
DEBUG=false
FRONTEND_URL=http://localhost:3000

# JWT Security
# REQUIRED. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace_with_at_least_32_random_characters

# Admin Seeding Credentials
# ADMIN_PASSWORD is REQUIRED. Do not ship the default; rotate after first login.
ADMIN_EMAIL=admin@energyforecast.com
ADMIN_PASSWORD=replace_with_a_long_random_admin_password

# Browser-facing API URL embedded into the frontend build
NEXT_PUBLIC_API_URL=http://localhost:8000

# REQUIRED when DEBUG=false. These values are displayed on public policy pages.
LEGAL_OWNER_NAME=
LEGAL_CONTACT_EMAIL=
SUPPORT_EMAIL=
LEGAL_EFFECTIVE_DATE=

# The packaged 24h, 168h, and 30-day daily artifacts are part of the PFE runtime.
FORECAST_168H_ENABLED=true
FORECAST_30D_ENABLED=true
# Keep external provider capabilities disabled until each independent gate passes.
EMAIL_DELIVERY_ENABLED=false
GOOGLE_AUTH_ENABLED=false

# Required only when the corresponding integration is enabled.
PUBLIC_FRONTEND_URL=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=EnergyForecast
EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=20
EMAIL_WORKER_POLL_SECONDS=30
EMAIL_LEASE_SECONDS=120
EMAIL_RETRY_BASE_SECONDS=60
EMAIL_MAX_ATTEMPTS=5
REFRESH_COOKIE_DOMAIN=
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Durable avatar storage and retryable cleanup
AVATAR_MAX_BYTES=2097152
AVATAR_MAX_DIMENSION=2048
AVATAR_CLEANUP_POLL_SECONDS=60
AVATAR_CLEANUP_MAX_ATTEMPTS=8
AVATAR_CLEANUP_RETRY_SECONDS=60
