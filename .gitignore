*.ckpt
*.pth
*.pkl
*.pickle
*.joblib
*.pt
*.onnx
*.h5

# Product runtime models remain eligible for tracking; this rule does not
# match backend/model_artifacts/**.
!backend/model_artifacts/**

# Retained Product V1 unknowns are explicit review artifacts, not disposable
# generated output, even though their parent patterns are ignored above.
!data/app_test_samples.csv
!models/archive/results.csv
!static/dummy_export.csv
!results/benchmark.csv
!results/benchmark.md
benchmark_report.json
playwright-report/
test-results/
logs_*.txt
test.csv
lint_results.txt

# Local report rendering, browser captures, and deployment scratch files
tmp/

# Reference papers are kept locally; commit citations and analysis instead of
# republishing third-party PDF files.
docs/research/**/*.pdf
